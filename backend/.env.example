# Copiá este archivo como `.env` y completá con tus valores reales.
# El archivo `.env` NUNCA se sube a git (está en .gitignore).

# Conexión a PostgreSQL local
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/bicimotos_mincho"

# Puerto donde corre la API
PORT=4000

# Secreto para firmar los tokens JWT del admin (poné cualquier string largo y aleatorio)
JWT_SECRET="cambiar-por-un-string-largo-y-secreto"

# Número de WhatsApp del dueño (con código de país, sin + ni espacios)
# Ej: 5491123456789
WHATSAPP_NUMBER="573184280375"

